generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

// NOTE: type/level/region/fundingType/status are plain strings (not native
// Prisma enums) on purpose — SQLite has no native enum support, and this way
// the schema moves to Postgres later without a migration rewrite. Allowed
// values are enforced in code via src/lib/taxonomy.ts + zod, not the DB.
//
// @db.Text on long content fields: MySQL's default String column
// (VARCHAR(191)) would silently truncate markdown bodies, FAQs, etc.

model Opportunity {
  id            String   @id @default(cuid())
  title         String
  slug          String   @unique
  type          String // scholarship | job | grant | fellowship | internship | competition | conference | exchange | training | workshop | volunteering | other
  status        String   @default("draft") // draft | published
  summary       String   @db.Text
  body          String   @db.Text // long-form article body, stored as markdown — the "Overview" section
  eligibility     String? @db.Text // markdown
  benefitsFunding String? @db.Text // markdown
  requiredDocuments String? @db.Text // markdown
  howToApply      String? @db.Text // markdown
  importantDates  String? @db.Text // markdown
  faqs            String? @db.Text // plain text, "Q: ...\nA: ..." pairs, parsed in code
  organization  String
  officialUrl   String   @db.Text
  country       String?
  region        String // africa | asia | europe | north-america | south-america | oceania | middle-east | global
  level         String? // high-school | undergraduate | masters | phd | postdoc | professional | any
  fundingType   String // fully-funded | partially-funded | paid | unpaid | unspecified
  deadline      DateTime?
  coverImage    String?  @db.Text
  isFeatured    Boolean  @default(false)
  viewCount     Int      @default(0)
  publishedAt   DateTime?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  tags          TagOnOpportunity[]

  @@index([type])
  @@index([region])
  @@index([status])
  @@index([deadline])
  @@index([status, publishedAt])
}

model Article {
  id          String   @id @default(cuid())
  title       String
  slug        String   @unique
  excerpt     String   @db.Text
  body        String   @db.Text
  coverImage  String?  @db.Text
  author      String   @default("WorldOpportunitiesHub Team")
  status      String   @default("draft") // draft | published
  publishedAt DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  tags        TagOnArticle[]

  @@index([status])
}

model Tag {
  id           String             @id @default(cuid())
  name         String             @unique
  slug         String             @unique
  opportunities TagOnOpportunity[]
  articles     TagOnArticle[]
}

model TagOnOpportunity {
  opportunity   Opportunity @relation(fields: [opportunityId], references: [id], onDelete: Cascade)
  opportunityId String
  tag           Tag         @relation(fields: [tagId], references: [id], onDelete: Cascade)
  tagId         String

  @@id([opportunityId, tagId])
}

model TagOnArticle {
  article   Article @relation(fields: [articleId], references: [id], onDelete: Cascade)
  articleId String
  tag       Tag     @relation(fields: [tagId], references: [id], onDelete: Cascade)
  tagId     String

  @@id([articleId, tagId])
}

model AdminUser {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  name         String
  createdAt    DateTime @default(now())
}

model NewsletterSubscriber {
  id        String   @id @default(cuid())
  email     String   @unique
  createdAt DateTime @default(now())
}
